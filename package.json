{
  "name": "boga-vivek-portfolio-mern",
  "version": "1.0.0",
  "description": "Full-Stack MERN Portfolio Application for Boga Vivek",
  "scripts": {
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client",
